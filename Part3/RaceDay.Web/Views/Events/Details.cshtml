@model EventDetailsViewModel
@{ ViewData["Title"] = Model.Event.Name; var ev = Model.Event; }

<div class="event-banner mb-4">
    <img src="@Url.Content(Display.Media(ev.BannerImage))" alt="Banner for @ev.Name" />
    <div class="event-banner-overlay">
        <span class="type-pill"><i class="bi @Display.TypeIcon(ev.EventType)"></i> @ev.EventType</span>
        <h1 class="rd-heading">@ev.Name</h1>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card rd-card mb-4">
            <div class="card-body">
                <h2 class="h4 rd-heading">About this event</h2>
                @if (string.IsNullOrWhiteSpace(ev.Description))
                {
                    <p class="text-muted mb-0">The organiser has not added a description yet.</p>
                }
                else
                {
                    <p class="mb-0" style="white-space: pre-line">@ev.Description</p>
                }
            </div>
        </div>

        <div class="card rd-card">
            <div class="card-body">
                <h2 class="h4 rd-heading">Categories</h2>
                @if (!Model.Categories.Any())
                {
                    <p class="text-muted mb-0">No categories have been added yet. Check back soon.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle rd-table">
                            <thead>
                                <tr><th>Category</th><th>Ages</th><th>Distance</th><th>Entry fee</th><th>Places</th>@if (Model.CanEnrol) {<th></th>}</tr>
                            </thead>
                            <tbody>
                            @foreach (var c in Model.Categories)
                            {
                                <tr>
                                    <td class="fw-semibold">@c.Name</td>
                                    <td>@Display.Ages(c.MinAge, c.MaxAge)</td>
                                    <td>@Display.Km(c.Distance ?? ev.Distance)</td>
                                    <td>@Display.Money(c.EntryFee)</td>
                                    <td>@(c.MaxParticipants?.ToString() ?? "Unlimited")</td>
                                    @if (Model.CanEnrol)
                                    {
                                        <td class="text-end">
                                            <form asp-controller="MyEnrolments" asp-action="Enrol" method="post">
                                                <input type="hidden" name="eventId" value="@ev.Id" />
                                                <input type="hidden" name="categoryId" value="@c.Id" />
                                                <button type="submit" class="btn btn-rd btn-sm">Enrol</button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card rd-card mb-4">
            <div class="card-body">
                <h2 class="h5 rd-heading">Event details</h2>
                <ul class="meta-list meta-list-lg">
                    <li><i class="bi bi-calendar3"></i> @Display.Date(ev.Date)</li>
                    <li><i class="bi bi-geo-alt"></i> @(ev.Location ?? "Location to be announced")</li>
                    <li><i class="bi bi-signpost-split"></i> @Display.Km(ev.Distance)</li>
                    <li><i class="bi bi-person-badge"></i> Organised by @ev.OrganiserName</li>
                </ul>
            </div>
        </div>

        @if (Model.MyEnrolment is not null)
        {
            <div class="card rd-card border-success-subtle">
                <div class="card-body">
                    <h2 class="h5 rd-heading">Your enrolment</h2>
                    <p class="mb-2">@Model.MyEnrolment.CategoryName</p>
                    <span class="status-pill @Display.StatusClass(Model.MyEnrolment.Status)">@Model.MyEnrolment.Status</span>
                    <div class="mt-3"><a asp-controller="MyEnrolments" asp-action="Index">View all my enrolments</a></div>
                </div>
            </div>
        }
        else if (Model.IsOwner)
        {
            <div class="card rd-card">
                <div class="card-body d-grid gap-2">
                    <h2 class="h5 rd-heading">Manage this event</h2>
                    <a class="btn btn-rd" asp-controller="ManageEvents" asp-action="Edit" asp-route-id="@ev.Id">Edit event</a>
                    <a class="btn btn-outline-dark" asp-controller="Categories" asp-action="Index" asp-route-eventId="@ev.Id">Categories</a>
                    <a class="btn btn-outline-dark" asp-controller="EventEnrolments" asp-action="Index" asp-route-eventId="@ev.Id">Enrolments</a>
                    <a class="btn btn-outline-dark" asp-controller="ResultsEntry" asp-action="Index" asp-route-eventId="@ev.Id">Results</a>
                </div>
            </div>
        }
        else if (!Model.CanEnrol && ev.Date < DateOnly.FromDateTime(DateTime.Today))
        {
            <div class="alert alert-secondary mb-0">This event has already taken place.</div>
        }
    </div>
</div>
