@model List<EnrolmentDto>
@{ ViewData["Title"] = "My enrolments"; }
<div class="page-head">
    <h1 class="rd-heading">My enrolments</h1>
    <p class="text-muted mb-0">Every event you have entered and where each enrolment stands.</p>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-ticket-perforated"></i>
        <p>You have not enrolled in any events yet.</p>
        <a class="btn btn-rd" asp-controller="Home" asp-action="Index">Find an event</a>
    </div>
}
else
{
    <div class="card rd-card">
        <div class="table-responsive">
            <table class="table align-middle rd-table mb-0">
                <thead><tr><th>Event</th><th>Event date</th><th>Category</th><th>Enrolled on</th><th>Status</th></tr></thead>
                <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><a class="fw-semibold" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a></td>
                        <td>@Display.Date(e.EventDate)</td>
                        <td>@e.CategoryName</td>
                        <td>@e.EnrolmentDate.ToString("d MMM yyyy")</td>
                        <td><span class="status-pill @Display.StatusClass(e.Status)">@e.Status</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
