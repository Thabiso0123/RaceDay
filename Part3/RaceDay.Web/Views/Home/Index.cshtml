@model HomeViewModel
@{ ViewData["Title"] = "Upcoming events"; }
<section class="rd-hero rd-hero-sm mb-4">
    <div class="rd-hero-inner">
        <span class="kicker">Upcoming events</span>
        <h1 class="rd-heading">Find your next race</h1>
    </div>
</section>

<form method="get" asp-controller="Home" asp-action="Index" class="filter-bar row g-2 align-items-end mb-4">
    <div class="col-md-5">
        <label class="form-label" for="q">Search</label>
        <input id="q" name="q" value="@Model.Query" class="form-control" placeholder="Event name or location" />
    </div>
    <div class="col-md-4">
        <label class="form-label" for="type">Event type</label>
        <select id="type" name="type" class="form-select">
            <option value="" selected="@(Model.SelectedType is null)">All types</option>
            @foreach (var t in Enum.GetValues<EventType>())
            {
                <option value="@t" selected="@(Model.SelectedType == t)">@t</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button class="btn btn-rd flex-grow-1" type="submit"><i class="bi bi-funnel"></i> Filter</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
    </div>
</form>

@if (!Model.Events.Any())
{
    <div class="empty-state">
        <i class="bi bi-calendar-x"></i>
        <p>No upcoming events match your filters.</p>
        <a class="btn btn-rd" asp-action="Index">Clear filters</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col">
                <div class="card rd-card h-100">
                    <div class="card-img-wrap">
                        <img src="@Url.Content(Display.Media(ev.BannerImage))" class="card-img-top" alt="Banner for @ev.Name" />
                        <span class="type-pill"><i class="bi @Display.TypeIcon(ev.EventType)"></i> @ev.EventType</span>
                        @if (Model.EnrolledEventIds.Contains(ev.Id))
                        {
                            <span class="status-pill status-confirmed enrolled-flag"><i class="bi bi-check2"></i> Enrolled</span>
                        }
                    </div>
                    <div class="card-body">
                        <h2 class="h5 rd-heading mb-1">@ev.Name</h2>
                        <ul class="meta-list">
                            <li><i class="bi bi-calendar3"></i> @Display.Date(ev.Date)</li>
                            <li><i class="bi bi-geo-alt"></i> @(ev.Location ?? "Location to be announced")</li>
                            <li><i class="bi bi-signpost-split"></i> @Display.Km(ev.Distance)</li>
                        </ul>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0 pb-3">
                        <a class="btn btn-rd w-100" asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id">View event</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
