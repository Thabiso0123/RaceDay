@model EventFormViewModel
@{ ViewData["Title"] = Model.IsEdit ? "Edit event" : "Create event"; }
<div class="page-head">
    <h1 class="rd-heading">@(Model.IsEdit ? "Edit event" : "Create a new event")</h1>
</div>

<div class="card rd-card">
    <div class="card-body p-4">
        <form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EventType" class="form-label"></label>
                    <select asp-for="EventType" asp-items="Html.GetEnumSelectList<EventType>()" class="form-select"></select>
                    <span asp-validation-for="EventType" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Date" class="form-label">Event date</label>
                    <input asp-for="Date" type="date" value="@Model.Date?.ToString("yyyy-MM-dd")" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Distance" class="form-label"></label>
                    <input asp-for="Distance" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="Distance" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" rows="5" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Banner" class="form-label"></label>
                    <div class="d-flex flex-wrap gap-3 align-items-start">
                        <img id="bannerPreview" class="banner-preview" src="@Url.Content(Display.Media(Model.CurrentBanner))" alt="Banner preview" />
                        <div class="flex-grow-1">
                            <input asp-for="Banner" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp,image/*" data-preview="#bannerPreview" />
                            <div class="form-text">JPG, PNG, GIF or WEBP, up to 5 MB. @(Model.IsEdit ? "Leave empty to keep the current banner." : "Optional.")</div>
                            <span asp-validation-for="Banner" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-rd">@(Model.IsEdit ? "Save changes" : "Create event")</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
