@model ErrorViewModel
@{ ViewData["Title"] = Model.Title; }
<div class="text-center py-5">
    <div class="display-1 rd-heading text-orange">@(Model.Code == 0 ? "!" : Model.Code.ToString())</div>
    <h1 class="rd-heading">@Model.Title</h1>
    <p class="text-muted">@Model.Message</p>
    <a class="btn btn-rd" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Back to home</a>
</div>
